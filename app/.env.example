# URL of the MiniLedger API.
# iOS simulator and Expo web: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical phone: http://<your computer's LAN IP>:4000
# Restart Expo after changing this. The value is inlined when the bundle is built.
EXPO_PUBLIC_API_URL=http://localhost:4000
