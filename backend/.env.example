# Copy to backend/.env. These values match docker-compose.yml.
PORT=4000
DATABASE_URL=postgres://miniledger:miniledger@localhost:5432/miniledger
# Used to sign login tokens and to HMAC one-time codes. Change it for anything but local development.
JWT_SECRET=change-me-to-a-long-random-string
# How long a printed OTP stays valid.
OTP_TTL_SECONDS=300
# Receipt photos are written here. Override in tests.
UPLOADS_DIR=uploads
